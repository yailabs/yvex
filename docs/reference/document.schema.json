{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YVEX document metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audience",
    "document",
    "id",
    "owner",
    "publication",
    "status",
    "title"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "document": {
      "enum": [
        "architecture",
        "architecture-plane",
        "evaluation",
        "guide",
        "product",
        "project-control",
        "reference",
        "research"
      ]
    },
    "status": {
      "enum": [
        "current",
        "deprecated",
        "live",
        "mixed",
        "research",
        "target"
      ]
    },
    "owner": {
      "enum": [
        "artifact",
        "backend",
        "compiler",
        "docs",
        "evaluation",
        "interfaces",
        "model",
        "project",
        "research",
        "runtime",
        "source",
        "yvex"
      ]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent",
          "developer",
          "engineer",
          "evaluator",
          "founder",
          "researcher"
        ]
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html",
        "pdf",
        "index"
      ],
      "properties": {
        "html": {
          "type": "boolean"
        },
        "pdf": {
          "type": "boolean"
        },
        "index": {
          "type": "boolean"
        }
      }
    },
    "plane": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    },
    "generated": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
