{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yvex.finite.request.v1",
  "title": "YVEX remote finite-decision request v1",
  "$comment": "One UTF-8 JSONL request <=32768 bytes including LF. Bounds below count characters; the producer additionally enforces public C UTF-8 byte bounds, no NUL, duplicate-field refusal and unique candidate IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "operation", "input"],
  "properties": {
    "schema": {"const": "yvex.finite.request.v1"},
    "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"const": "finite.decision.execute"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["model_alias", "expected_generation", "question", "context", "candidates"],
      "properties": {
        "model_alias": {"type":"string", "minLength":1, "maxLength":127, "pattern":"^[^\u0000]*$"},
        "expected_generation": {"type":"integer", "minimum":1, "maximum":18446744073709551615},
        "question": {"type":"string", "minLength":1, "maxLength":255, "pattern":"^[^\u0000]*$"},
        "context": {"type":"string", "maxLength":511, "pattern":"^[^\u0000]*$"},
        "candidates": {
          "type":"array", "minItems":1, "maxItems":8,
          "items": {
            "type":"object", "additionalProperties":false, "required":["id","text"],
            "properties": {
              "id":{"type":"string", "minLength":1, "maxLength":127, "pattern":"^[^\u0000]*$"},
              "text":{"type":"string", "minLength":1, "maxLength":127, "pattern":"^[^\u0000]*$"}
            }
          }
        }
      }
    }
  }
}
