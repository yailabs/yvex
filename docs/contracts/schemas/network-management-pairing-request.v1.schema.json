{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "yvex.management.pairing.request.v1",
  "required": [
    "schema",
    "credential_hash",
    "client_name"
  ],
  "properties": {
    "schema": {
      "const": "yvex.management.pairing.request.v1"
    },
    "credential_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
