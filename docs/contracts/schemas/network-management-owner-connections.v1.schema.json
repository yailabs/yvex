{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yvex.management.owner.connections.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "owner_ref",
    "revision",
    "open_until_unix_ms",
    "peers"
  ],
  "properties": {
    "schema": {
      "const": "yvex.management.owner.connections.v1"
    },
    "scope": {
      "const": "pairing-administration"
    },
    "owner_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "open_until_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "client_name",
          "posture",
          "scope",
          "expires_at_unix_ms"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "client_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "posture": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "revoked",
              "expired",
              "refused"
            ]
          },
          "scope": {
            "const": "product-management"
          },
          "expires_at_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "service_control_granted": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 160
    },
    "available_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pairing_open",
          "pairing_approve",
          "pairing_revoke",
          "owner_revoke",
          "service_control_grant",
          "service_control_revoke"
        ]
      }
    }
  }
}
