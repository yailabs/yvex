#!/usr/bin/env sh
set -eu

if [ "${YVEX_FAKE_HF_REQUIRE_ANONYMOUS:-0}" = 1 ] && [ "${1:-}" != auth ]; then
  if [ -n "${HF_TOKEN:-}" ] || [ -n "${HUGGING_FACE_HUB_TOKEN:-}" ] ||
     [ "${HF_HUB_DISABLE_IMPLICIT_TOKEN:-0}" != 1 ]; then
    printf 'anonymous provider policy was not applied\n' >&2
    exit 1
  fi
fi

log_path=${YVEX_FAKE_HF_LOG:-build/tests/fake-hf.log}
mkdir -p "$(dirname "$log_path")"

{
  printf 'fake-hf argv:\n'
  redact_next=0
  for arg in "$@"; do
    if [ "$redact_next" -eq 1 ]; then
      printf '  <redacted>\n'
      redact_next=0
      continue
    fi
    printf '  %s\n' "$arg"
    if [ "$arg" = "--token" ]; then
      redact_next=1
    fi
  done
} >> "$log_path"

state_path=${YVEX_FAKE_HF_STATE:-build/tests/fake-hf.auth}

if [ "$#" -ge 2 ] && [ "$1" = "auth" ]; then
  case "$2" in
    whoami)
      if [ "${YVEX_FAKE_HF_AUTH:-0}" = "1" ] || [ -f "$state_path" ]; then
        printf 'fake-hf-user\n'
        exit 0
      fi
      printf 'fake-hf: not logged in\n' >&2
      exit 1
      ;;
    login)
      if [ "${YVEX_FAKE_HF_LOGIN_FAIL:-0}" = "1" ]; then
        printf 'fake-hf: login failed\n' >&2
        exit 41
      fi
      if [ "${YVEX_FAKE_HF_LOGIN_OK:-0}" = "1" ]; then
        mkdir -p "$(dirname "$state_path")"
        printf 'fake-hf-user\n' > "$state_path"
        printf 'fake-hf: login ok\n'
        exit 0
      fi
      printf 'fake-hf: login not allowed by test env\n' >&2
      exit 40
      ;;
    logout)
      rm -f "$state_path"
      printf 'fake-hf: logout ok\n'
      exit 0
      ;;
  esac
fi

if [ "${YVEX_FAKE_HF_FAIL:-0}" = "1" ]; then
  printf 'fake-hf: requested failure\n' >&2
  exit 42
fi

if [ "$#" -ge 2 ] && [ "$1" = "models" ]; then
  if [ "${YVEX_FAKE_HF_DISCOVERY_AUTH:-0}" = "1" ]; then
    printf 'fake-hf: 401 gated repository requires authentication\n' >&2
    exit 41
  fi
  if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "malformed" ]; then
    printf '{not-json\n'
    exit 0
  fi
  if [ "$2" = "info" ]; then
    repo=${3:-MiniMaxAI/MiniMax-H3}
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "model-not-found" ]; then
      printf 'fake-hf: repository not found\n' >&2
      exit 44
    fi
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "revision-not-found" ]; then
      printf 'fake-hf: revision not found\n' >&2
      exit 44
    fi
    resolved_sha=${YVEX_FAKE_HF_RESOLVED_SHA:-b8b09e34f8d2b9d1b7a51982ccb26ae2b8b9ef08}
    gated=false
    [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "gated" ] && gated='"manual"'
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "tiny" ]; then
      cat <<JSON
{"id":"$repo","author":"yvex-fixtures","sha":"$resolved_sha","pipeline_tag":"text-generation","gated":false,"tags":["gguf","test-fixture"]}
JSON
      exit 0
    fi
    if [ "$repo" = "deepseek-ai/DeepSeek-V4-Flash-DSpark" ]; then
      cat <<JSON
{"id":"$repo","author":"deepseek-ai","sha":"$resolved_sha","pipeline_tag":"text-generation","gated":$gated,"tags":["deepseek","safetensors"],"safetensors":{"parameters":{"BF16":33000000000},"total":33000000000},"transformers_info":{"auto_model":"DeepSeekV4ForCausalLM"}}
JSON
      exit 0
    fi
    if [ "$repo" = "unsloth/MiniMax-H3-GGUF" ]; then
      cat <<JSON
{"id":"$repo","author":"unsloth","sha":"$resolved_sha","pipeline_tag":"text-to-video","gated":$gated,"tags":["minimax-h3","gguf","quantized"],"base_models":{"relation":"quantized","models":[{"id":"MiniMaxAI/MiniMax-H3"}]}}
JSON
      exit 0
    fi
    cat <<JSON
{"id":"$repo","author":"MiniMaxAI","sha":"$resolved_sha","pipeline_tag":"text-to-video","gated":$gated,"tags":["minimax-h3","safetensors","gguf"],"safetensors":{"parameters":{"BF16":33000000000,"F16":1024},"total":33000001024},"transformers_info":{"auto_model":"MiniMaxH3ForConditionalGeneration"},"base_models":{"relation":"finetune","models":[{"id":"MiniMaxAI/MiniMax-H3-Base"}]}}
JSON
    exit 0
  fi
  if [ "$2" = "list" ] && [ "$#" -ge 3 ] && [ "${3#-}" = "$3" ]; then
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "alternative-safetensors" ]; then
      printf '%s\n' '[{"path":"config.json","size":512},{"path":"consolidated.safetensors","size":3072},{"path":"model-00001-of-00002.safetensors","size":1024},{"path":"model-00002-of-00002.safetensors","size":2048},{"path":"model.safetensors.index.json","size":128},{"path":"tokenizer.json","size":256}]'
      exit 0
    fi
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "incomplete-shards" ]; then
      printf '%s\n' '[{"path":"config.json","size":512},{"path":"model-00001-of-00002.safetensors","size":1024}]'
      exit 0
    fi
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "duplicate-shards" ]; then
      printf '%s\n' '[{"path":"model-00001-of-00002.safetensors","size":1024},{"path":"model-00001-of-00002.safetensors","size":1024}]'
      exit 0
    fi
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "unsafe-file" ]; then
      printf '[{"path":"../escape.gguf","size":16}]\n'
      exit 0
    fi
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "tiny" ]; then
      tiny_bytes=${YVEX_FAKE_HF_TINY_BYTES:-0}
      if [ -n "${YVEX_FAKE_HF_TINY_SHA:-}" ]; then
        printf '[{"path":"model-Q4_K_M.gguf","size":%s,"lfs":{"oid":"%s"}}]\n' \
          "$tiny_bytes" "$YVEX_FAKE_HF_TINY_SHA"
      else
        printf '[{"path":"model-Q4_K_M.gguf","size":%s}]\n' "$tiny_bytes"
      fi
      exit 0
    fi
    if [ "$3" = "unsloth/MiniMax-H3-GGUF" ]; then
      cat <<'JSON'
[{"path":"MiniMax-H3-Q4_K_M.gguf","size":4096},{"path":"README.md","size":128}]
JSON
      exit 0
    fi
    cat <<'JSON'
[{"path":"config.json","size":512},{"path":"model-00001-of-00002.safetensors","size":1024},{"path":"model-00002-of-00002.safetensors","size":2048},{"path":"model-Q4_K_M.gguf","size":4096},{"path":"model-IQ2_XXS.gguf","size":2048},{"path":"README.md","size":128},{"path":"tokenizer.json","size":256}]
JSON
    exit 0
  fi
  if [ "$2" = "list" ]; then
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "empty" ]; then
      printf '[]\n'
      exit 0
    fi
    search_sha=${YVEX_FAKE_HF_RESOLVED_SHA:-b8b09e34f8d2b9d1b7a51982ccb26ae2b8b9ef08}
    if [ "${YVEX_FAKE_HF_DISCOVERY_MODE:-mixed}" = "tiny" ]; then
      cat <<JSON
[{"id":"yvex-fixtures/tiny-executable","author":"yvex-fixtures","sha":"$search_sha","pipeline_tag":"text-generation","gated":false,"tags":["gguf","test-fixture"]}]
JSON
      exit 0
    fi
    cat <<JSON
[{"id":"fal/MiniMax-H3-Realism-People-LoRA","author":"fal","sha":"4444444444444444444444444444444444444444","pipeline_tag":"text-to-video","gated":false,"tags":["minimax-h3","lora","safetensors"],"base_models":{"relation":"adapter","models":[{"id":"MiniMaxAI/MiniMax-H3"}]}},{"id":"LBH-123-AI/Minimax_h3_latent_Upscaler","author":"LBH-123-AI","sha":"5555555555555555555555555555555555555555","pipeline_tag":"text-to-video","gated":false,"tags":["minimax-h3","upscaler","safetensors"]},{"id":"MiniMaxAI/MiniMax-H3","author":"MiniMaxAI","sha":"$search_sha","pipeline_tag":"text-to-video","gated":false,"tags":["minimax-h3","safetensors"],"safetensors":{"parameters":{"BF16":33000000000,"F16":1024},"total":33000001024},"transformers_info":{"auto_model":"MiniMaxH3ForConditionalGeneration"}},{"id":"unsloth/MiniMax-H3-GGUF","author":"unsloth","sha":"2222222222222222222222222222222222222222","pipeline_tag":"text-to-video","gated":false,"tags":["minimax-h3","gguf","quantized"],"base_models":{"relation":"quantized","models":[{"id":"MiniMaxAI/MiniMax-H3"}]}},{"id":"community/MiniMax-H3-finetune","author":"community","sha":"6666666666666666666666666666666666666666","pipeline_tag":"text-to-video","gated":false,"tags":["minimax-h3","safetensors","finetune"],"base_models":{"relation":"finetune","models":[{"id":"MiniMaxAI/MiniMax-H3"}]}},{"id":"community/unknown-model","author":"community","sha":"1111111111111111111111111111111111111111","pipeline_tag":"unknown","gated":false,"tags":["safetensors"],"safetensors":{"parameters":{"F32":1000},"total":1000}},{"id":"private/gated-model","author":"private","sha":"3333333333333333333333333333333333333333","pipeline_tag":"text-generation","gated":"manual","tags":["qwen","safetensors"],"safetensors":{"parameters":{"BF16":2000},"total":2000},"transformers_info":{"auto_model":"QwenForCausalLM"}}]
JSON
    exit 0
  fi
fi

if [ "$#" -lt 2 ] || [ "$1" != "download" ]; then
  printf 'fake-hf: expected download REPO\n' >&2
  exit 2
fi

if [ "${HF_HUB_OFFLINE:-0}" = "1" ]; then
  if [ -n "${YVEX_FAKE_HF_CACHE_FILE:-}" ]; then
    printf '%s\n' "$YVEX_FAKE_HF_CACHE_FILE"
    exit 0
  fi
  exit 1
fi

repo=$2
shift 2
local_dir=
dry_run=0
gguf_download=0
release_filename=model.gguf

while [ "$#" -gt 0 ]; do
  case "$1" in
    --local-dir)
      [ "$#" -ge 2 ] || exit 2
      local_dir=$2
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --include)
      [ "$#" -ge 2 ] || exit 2
      case "$2" in
        *.gguf) gguf_download=1 ;;
      esac
      shift 2
      ;;
    --revision|--exclude|--max-workers|--token)
      [ "$#" -ge 2 ] || exit 2
      shift 2
      ;;
    *.gguf)
      release_filename=$1
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [ "$dry_run" -eq 1 ]; then
  printf 'fake-hf: dry-run repo=%s local_dir=%s\n' "$repo" "$local_dir"
  exit 0
fi

if [ -z "$local_dir" ]; then
  printf 'fake-hf: --local-dir is required\n' >&2
  exit 2
fi

if [ -n "${YVEX_FAKE_HF_EXPECT_CACHE_ROOT:-}" ]; then
  expected_hub=$YVEX_FAKE_HF_EXPECT_CACHE_ROOT/cache/provider/huggingface/hub
  expected_xet=$YVEX_FAKE_HF_EXPECT_CACHE_ROOT/cache/provider/huggingface/xet
  if [ "${HF_HUB_CACHE:-}" != "$expected_hub" ] ||
     [ "${HF_XET_CACHE:-}" != "$expected_xet" ]; then
    printf 'fake-hf: provider cache policy mismatch\n' >&2
    exit 45
  fi
fi
if [ -n "${YVEX_FAKE_HF_EXPECT_HUB_CACHE:-}" ] &&
   [ "${HF_HUB_CACHE:-}" != "$YVEX_FAKE_HF_EXPECT_HUB_CACHE" ]; then
  printf 'fake-hf: explicit hub cache policy mismatch\n' >&2
  exit 47
fi
if [ -n "${YVEX_FAKE_HF_EXPECT_XET_CACHE:-}" ] &&
   [ "${HF_XET_CACHE:-}" != "$YVEX_FAKE_HF_EXPECT_XET_CACHE" ]; then
  printf 'fake-hf: explicit xet cache policy mismatch\n' >&2
  exit 48
fi
if [ -n "${YVEX_FAKE_HF_EXPECT_HIGH_PERFORMANCE:-}" ] &&
   [ "${HF_XET_HIGH_PERFORMANCE:-}" != "$YVEX_FAKE_HF_EXPECT_HIGH_PERFORMANCE" ]; then
  printf 'fake-hf: high-performance override mismatch\n' >&2
  exit 46
fi

mkdir -p "$local_dir"

# The supervisor-crash fixture needs a provider that remains alive after its
# owning supervisor disappears.  Redirect its human stream before the crash so
# a broken supervisor pipe cannot terminate the fixture with SIGPIPE; structured
# provider events and payload writes remain observable through their own files.
if [ "${YVEX_FAKE_HF_ORPHAN_SURVIVE:-0}" = 1 ]; then
  exec >/dev/null 2>/dev/null
fi

step_delay=${YVEX_FAKE_HF_STEP_DELAY:-0}
steps=${YVEX_FAKE_HF_STEPS:-3}
fail_at=${YVEX_FAKE_HF_FAIL_AT_STEP:-0}
retry_before=${YVEX_FAKE_HF_RETRY_BEFORE:-0}
partial_path=
provider_event_sequence=0
if [ "${YVEX_FAKE_HF_PARTIAL_OBJECT:-0}" = 1 ]; then
  partial_path=$local_dir/.cache/huggingface/download/model.incomplete
  mkdir -p "$(dirname "$partial_path")"
  printf 'provider-owned partial object\n' > "$partial_path"
fi

provider_event() {
  kind=$1
  object=$2
  retry=$3
  test "${YVEX_FAKE_HF_DISABLE_EVENTS:-0}" != 1 || return 0
  test -n "${YVEX_PROVIDER_EVENT_PATH:-}" || return 0
  provider_event_sequence=$((provider_event_sequence + 1))
  event_pending=$YVEX_PROVIDER_EVENT_PATH.pending.$$
  printf '{"schema":"yvex.provider.acquisition.event.v1","sequence":%s,"kind":"%s","object":"%s","retry_count":%s}\n' \
    "$provider_event_sequence" "$kind" "$object" "$retry" > "$event_pending"
  mv "$event_pending" "$YVEX_PROVIDER_EVENT_PATH"
}

if [ "$retry_before" != 0 ]; then
  provider_event retry model-00001-of-00002.safetensors 1
  sleep "$retry_before"
fi

fake_hf_step() {
  step=$1
  if [ "$fail_at" = "$step" ]; then
    printf 'fake-hf: failing at step %s\n' "$step" >&2
    exit 43
  fi
  if [ "$step_delay" != "0" ]; then
    sleep "$step_delay"
  fi
}

fake_hf_write_shard() {
  python3 - "$1" "$2" "$3" <<'PY'
import json
import struct
import sys

path = sys.argv[1]
name = sys.argv[2]
payload_len = int(sys.argv[3])
header = {
    "__metadata__": {"format": "pt"},
    name: {
        "dtype": "F16",
        "shape": [2, max(1, payload_len // 4)],
        "data_offsets": [0, payload_len],
    },
}
blob = json.dumps(header, separators=(",", ":")).encode("utf-8")
with open(path, "wb") as f:
    f.write(struct.pack("<Q", len(blob)))
    f.write(blob)
    f.write(bytes(payload_len))
PY
}

if [ -n "${YVEX_FAKE_HF_RELEASE_FILE:-}" ]; then
  mkdir -p "$local_dir/.cache"
  python3 - "$YVEX_FAKE_HF_RELEASE_FILE" "$local_dir/.cache/model.incomplete" <<'PYDATA'
from pathlib import Path
import sys
payload = Path(sys.argv[1]).read_bytes()
Path(sys.argv[2]).write_bytes(payload[:len(payload)//2])
PYDATA
  fake_hf_step 1
  cp "$YVEX_FAKE_HF_RELEASE_FILE" "$local_dir/$release_filename"
  rm "$local_dir/.cache/model.incomplete"
  printf '%s/%s\n' "$local_dir" "$release_filename"
  exit 0
fi

printf 'fake-hf: resolving repo\n'
provider_event progress config.json 0
printf 'fake-hf: stderr resolving repo\n' >&2
printf '{}\n' > "$local_dir/config.json"
printf '{}\n' > "$local_dir/tokenizer.json"
printf '{}\n' > "$local_dir/tokenizer_config.json"
printf '# fake model card\n' > "$local_dir/README.md"
fake_hf_step 1

printf 'fake-hf: downloading shard 1\n'
provider_event progress model-00001-of-00002.safetensors 0
if [ "$gguf_download" -eq 1 ]; then
  if [ -n "${YVEX_FAKE_HF_DOWNLOAD_SOURCE:-}" ]; then
    cp "$YVEX_FAKE_HF_DOWNLOAD_SOURCE" "$local_dir/model-Q4_K_M.gguf"
  else
    printf 'GGUF fake provider fixture\n' > "$local_dir/model-Q4_K_M.gguf"
  fi
else
  fake_hf_write_shard "$local_dir/model-00001-of-00002.safetensors" "embed.weight" 16
fi
fake_hf_step 2

printf 'fake-hf: downloading shard 2\n'
provider_event progress model-00002-of-00002.safetensors 0
if [ "$gguf_download" -eq 0 ]; then
  fake_hf_write_shard "$local_dir/model-00002-of-00002.safetensors" "layers.0.attn.q_proj.weight" 32
fi
fake_hf_step 3

i=4
while [ "$i" -le "$steps" ]; do
  printf 'fake-hf: verifying step %s\n' "$i"
  provider_event progress "verification-step-$i" 0
  fake_hf_step "$i"
  i=$((i + 1))
done

if [ -n "$partial_path" ]; then
  rm -f "$partial_path"
fi

if [ "${YVEX_FAKE_HF_LOCAL_CACHE:-0}" = "1" ]; then
  mkdir -p "$local_dir/.cache/huggingface/download"
  printf 'provider transfer metadata\n' \
    > "$local_dir/.cache/huggingface/download/config.json.metadata"
fi

printf 'fake-hf: complete\n'
printf 'fake-hf: downloaded repo=%s local_dir=%s\n' "$repo" "$local_dir"
